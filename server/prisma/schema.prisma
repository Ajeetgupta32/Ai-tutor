datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  passwordHash          String
  role                  String          @default("student")
  avatar                String?         @default("")
  level                 String          @default("intermediate")
  xp                    Int             @default(0)
  status                String          @default("active")
  isEmailVerified       Boolean         @default(false)
  preferredLanguage     String          @default("en")
  learningSpeed         String          @default("normal")
  riskLevel             String          @default("low")
  riskReason            String          @default("")
  studyStreak           Int             @default(1)
  lastActiveDate        DateTime?       @default(now())
  totalQuizCount        Int             @default(0)
  averageScore          Float           @default(0)
  accuracyRate          Float           @default(0)
  totalStudyTimeMinutes Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  quizzes               Quiz[]
  quizAttempts          QuizAttempt[]
  studyMaterials        StudyMaterial[]
  studySessions         StudySession[]
  conversations         Conversation[]
  achievements          Achievement[]
  aiUsages              AIUsage[]
  goals                 Goal[]
  studyPlans            StudyPlan[]
  certificates          Certificate[]
  supportTickets        SupportTicket[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  roadmaps              LearningRoadmap[]

  @@map("users")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String
  description String   @default("")
  icon        String   @default("BookOpen")
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics        Topic[]
  quizzes       Quiz[]
  conversations Conversation[]
  courses       Course[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String   @default("")
  difficulty  String   @default("intermediate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]

  @@index([subjectId, name])
  @@map("topics")
}

model Quiz {
  id            String         @id @default(cuid())
  title         String
  subjectId     String?
  subjectName   String
  topicId       String?
  topicName     String
  difficulty    String
  questionType  String
  questionCount Int
  createdBy     String?
  isAiGenerated Boolean        @default(true)
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([createdBy, createdAt(sort: Desc)])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  questionText  String
  type          String
  options       String[] @default([])
  correctAnswer String
  explanation   String
  topic         String   @default("General")

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id               String       @id @default(cuid())
  userId           String
  quizId           String
  score            Float
  totalQuestions   Int
  percentage       Float
  accuracy         Float
  timeTakenSeconds Int
  weakTopics       String[]     @default([])
  strongTopics     String[]     @default([])
  completedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers          UserAnswer[]

  @@index([userId, completedAt(sort: Desc)])
  @@map("quiz_attempts")
}

model UserAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  userResponse  String
  isCorrect     Boolean
  correctAnswer String
  explanation   String
  topic         String      @default("General")

  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("user_answers")
}

model StudyMaterial {
  id            String   @id @default(cuid())
  userId        String
  title         String
  fileType      String
  fileSize      Int      @default(0)
  extractedText String   @db.Text
  summary       String   @default("") @db.Text
  keyTopics     String[] @default([])
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt(sort: Desc)])
  @@map("study_materials")
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  durationMinutes Int
  activityType    String
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
  @@map("study_sessions")
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  subjectName String    @default("General Science & Computer Science")
  title       String
  level       String    @default("intermediate")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String
  content        String       @db.Text
  language       String       @default("en")
  mode           String       @default("default")
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  badgeName   String
  badgeIcon   String
  description String
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeName])
  @@map("achievements")
}

model AIUsage {
  id          String   @id @default(cuid())
  userId      String
  actionType  String
  tokensUsed  Int      @default(0)
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@map("ai_usages")
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  type         String   @default("daily") // daily, weekly, exam, skill
  targetValue  Int      @default(1)
  currentValue Int      @default(0)
  targetDate   DateTime?
  isCompleted  Boolean  @default(false)
  xpReward     Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
  @@map("goals")
}

model StudyPlan {
  id           String   @id @default(cuid())
  userId       String
  title        String
  targetExam   String
  examDate     DateTime
  dailyHours   Float    @default(2.0)
  targetScore  Int      @default(90)
  scheduleJson Json     // Array of days with planned tasks
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("study_plans")
}

model Certificate {
  id               String   @id @default(cuid())
  certificateId    String   @unique
  userId           String
  title            String
  subjectName      String
  score            Float
  issuedAt         DateTime @default(now())
  verificationCode String   @unique

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

model Course {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  subjectId   String?
  subjectName String
  difficulty  String         @default("intermediate")
  isPublished Boolean        @default(true)
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  modules     CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String         @id @default(cuid())
  courseId    String
  title       String
  description String         @default("")
  order       Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  @@index([courseId, order])
  @@map("course_modules")
}

model CourseLesson {
  id              String       @id @default(cuid())
  moduleId        String
  title           String
  content         String       @db.Text
  durationMinutes Int          @default(15)
  order           Int          @default(1)
  isCompleted     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, order])
  @@map("course_lessons")
}

model QuestionBankItem {
  id            String   @id @default(cuid())
  subjectName   String
  topicName     String
  questionText  String   @db.Text
  type          String   @default("mcq")
  options       String[] @default([])
  correctAnswer String
  explanation   String   @db.Text
  difficulty    String   @default("intermediate")
  marks         Int      @default(1)
  status        String   @default("approved") // pending_review, approved, rejected, flagged
  isAiGenerated Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subjectName, topicName, status])
  @@map("question_bank_items")
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  userId      String
  category    String   @default("general") // general, quiz, technical, account, billing
  subject     String
  description String   @db.Text
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("open") // open, in_progress, resolved, closed
  adminReply  String?  @db.Text
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("support_tickets")
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  targetRole String    @default("all") // all, student, teacher, admin
  priority   String    @default("normal") // low, normal, high, urgent
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("announcements")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("system") // quiz, goal, streak, achievement, system, recommendation
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  actorEmail String
  action     String   // USER_UPDATED, ROLE_CHANGED, QUESTION_APPROVED, COURSE_PUBLISHED, etc.
  targetType String   // User, Question, Course, Announcement, System
  targetId   String?
  details    String   @default("")
  ipAddress  String   @default("127.0.0.1")
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, timestamp(sort: Desc)])
  @@map("audit_logs")
}

model LearningRoadmap {
  id              String   @id @default(cuid())
  userId          String
  subjectName     String
  nodesJson       Json     // Array of roadmap nodes with prerequisites & status
  overallProgress Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectName])
  @@map("learning_roadmaps")
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String   @default("registration") // registration, password_reset, login_2fa
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose, isUsed])
  @@map("otp_verifications")
}

